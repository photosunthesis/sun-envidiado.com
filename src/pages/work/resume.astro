            "HTML",
            "CSS",
          ],
        },
        {
          label: "Backend",
          items: [
            "C#",
            ".NET",
            "Entity Framework",
            "PHP",
            "Laravel",
            "REST APIs",
          ],
        },
        {
          label: "Databases",
          items: ["PostgreSQL", "MySQL", "MSSQL"],
        },
        {
          label: "Cloud & Infrastructure",
          items: [
            "Cloudflare (Workers, R2, Hyperdrive)",
            "Firebase (Auth, Firestore, Cloud Functions)",
            "Docker",
            "OrbStack",
          ],
        },
        {
          label: "CI/CD & Tooling",
          items: [
            "GitHub Actions",
            "Bitbucket Pipelines",
            "Azure DevOps",
            "Fastlane",
            "Git",
            "Xcode",
            "Android Studio",
          ],
        },
        {
          label: "Architecture & Practices",
          items: [
