---
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/400-italic.css";
import { yearsOfExperience } from "../../utils/experience";
import { nowrapHyphenated as nb } from "../../utils/text";

// Standalone print document: no BaseLayout, no global.css, no site font.
// Prerendering is already this site's default; the export makes it explicit.
export const prerender = true;

// The resume content lives here so there is one file to find and edit.
// Any text field may contain inline HTML (<b>, <i>, <a>); the template
// renders these fields raw. Section labels are sentence case here; the CSS
// uppercases them.

interface ResumeBullet {
  label?: string; // bold prefix, rendered as "Label: text"
  text: string;
}

interface ResumeEntry {
  // Kept apart so a parser reads a job title and an employer, not one run.
  title: string; // "Software Engineer"
  org?: string; // "MCS Inc. · Makati City, Philippines"
  date?: string; // "Mar 2026 - Present"
  intro?: string; // paragraph under the title
  bullets?: ResumeBullet[];
}

interface SkillGroup {
  label: string; // bold prefix, rendered as "Label: a, b, c"
  items: string[];
}

interface ResumeSection {
  label: string; // "EXPERIENCE", rendered uppercase by CSS not by data
  intro?: string; // optional paragraph before the entries
  entries?: ResumeEntry[];
  skills?: SkillGroup[]; // one comma separated run per group, one line each
  dashes?: boolean; // false hides the dash beside each entry title
}

interface Resume {
  name: string;
  role: string;
  contact: string[]; // one array entry per line; entries may contain <a> markup
  summary?: string;
  sections: ResumeSection[];
}

const years = yearsOfExperience();

const resume: Resume = {
