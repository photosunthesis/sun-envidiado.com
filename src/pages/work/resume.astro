---
import "@fontsource/bricolage-grotesque/latin-400.css";
import "@fontsource/bricolage-grotesque/latin-600.css";
import "@fontsource/bricolage-grotesque/latin-700.css";
import { yearsOfExperience } from "../../utils/experience";
import { nowrapHyphenated as nb } from "../../utils/text";

export const prerender = true;

interface ResumeBullet {
  label?: string;
  text: string;
}

interface ResumeEntry {
  title: string;
  org?: string;
  date?: string;
  intro?: string;
  bullets?: ResumeBullet[];
}

interface SkillGroup {
  label: string;
  items: string[];
}

interface ResumeSection {
  label: string;
  intro?: string;
  entries?: ResumeEntry[];
  skills?: SkillGroup[];
  dashes?: boolean;
}

interface Resume {
  name: string;
  role: string;
  contact: string[];
  summary?: string;
  sections: ResumeSection[];
}

const years = yearsOfExperience();

const resume: Resume = {
  name: "Sun Adriann B. Envidiado",
  role: "Software Engineer",
  contact: [
    "Metro Manila, PH",
    "<a href='mailto:sun.adriann@icloud.com'>sun.adriann@icloud.com</a>",
  ],
  summary: `Software engineer with <span data-yoe>${years}</span>+ years of experience across the full stack: mobile, backend, and web apps, taking features from the database through to the interface. Now on native Swift and SwiftUI for an iOS health coaching app, after years of shipping cross-platform apps in Flutter. Production work also covers Android through Flutter plugins written in Kotlin, backends in C#/.NET and PHP/Laravel, and web front ends in JavaScript, React, and Vue. Fintech, healthcare, and consumer products, where security and compliance requirements shaped the work, with LLMs in production apps and CI/CD owned on GitHub Actions and Azure DevOps. Builds and ships production features with Claude Code and Google Gemini in the loop for engineering, debugging, and code review.`,
  sections: [
    {
      label: "Experience",
      entries: [
        {
          title: "Software Engineer",
          org: "MCS Inc. · Makati City, Philippines",
          date: "Mar 2026 - Present",
          intro:
            "Owns the iOS codebase for a health coaching app and leads its technical direction inside an iOS team, setting the architecture the app was rebuilt on. The work is Swift and SwiftUI across LLM-backed product features, activity tracking, and release automation, alongside the re-architecture itself.",
          bullets: [
            {
              label: "Architectural Direction",
              text: "Set the architectural standards and review practices the iOS team builds against.",
            },
            {
              label: "Refactoring & Re-architecture",
              text: "Re-architected the app into reusable SwiftUI modules with Swift Package Manager so code could be shared across products.",
            },
            {
              label: "LLM Product Features",
              text: "Integrated a large language model (LLM) into the app for context-aware guidance and real-time in-app support, and built, debugged, and reviewed the work with Claude Code in the loop.",
            },
            {
              label: "Run & Walk Tracking",
              text: "Built the run and walk tracker end to end: live GPS route recording with pace, distance, and duration, a route map per session, and a full activity history, with workouts saved to Apple Health, built on Core Location, HealthKit, and Core Motion.",
            },
            {
              label: "Release Automation",
              text: "Built the automated release pipeline that took manual steps out of shipping, on Fastlane and Azure DevOps.",
            },
          ],
        },
        {
          title: "Flutter Developer",
          org: "Nextbank · Remote",
          date: "Nov 2023 - Mar 2026",
          intro:
            "Built secure, high-transaction iOS and Android fintech apps in a Flutter monorepo, delivering them alongside security and compliance stakeholders across regulated banking, lending, and remittance products.",
          bullets: [
            {
              label: "Native Security Integrations",
              text: "Implemented biometric face liveness detection and fraud mitigation by writing custom Flutter plugins in Swift and Kotlin over the platform-specific native SDKs, bridged through Method Channels, to support regulatory compliance.",
            },
            {
              label: "In-App AI Support",
              text: "Built the in-app AI support end to end, from evaluating providers through prompt and response handling, so users could get real-time help inside financial workflows, with OpenAI and other LLM providers in production.",
            },
            {
              label: "CI/CD Pipelines",
              text: "Built and maintained the GitHub Actions pipelines that built and shipped the apps.",
            },
            {
              label: "Shared Codebase Consolidation",
              text: "Re-architected a codebase shared across multiple banking apps in one monorepo, cutting duplicate code, shortening new-feature delivery, and lifting release frequency for the teams working in it, on an architecture structured with BLoC and GetIt.",
            },
          ],
        },
        {
          title: "Mobile Engineer",
          org: "Netsells (part of hedgehog lab) · Remote",
          date: "Aug 2022 - Nov 2023",
          intro:
            "Delivered cross-platform iOS and Android apps for medical and fintech clients as part of a cross-functional agency team, and contributed to the Laravel and PHP services behind them.",
          bullets: [
            {
              label: "Native Plugin Work",
              text: "Built a custom document signing plugin in Swift and Kotlin over the native iOS and Android SDKs, bridged through Method Channels.",
            },
            {
              label: "In-App Payments",
              text: "Implemented in-app payments for a client product through a Braintree integration, from the checkout flow through payment processing.",
            },
            {
              label: "CI/CD Pipelines",
              text: "Built and maintained the GitHub Actions pipelines for the client mobile projects.",
            },
            {
              label: "Full-Stack Contribution",
              text: "Contributed to the Laravel and PHP backend services alongside the mobile work.",
            },
            {
              label: "Concurrent Client Delivery",
              text: "Shipped for several agency clients at once, working in codebases built with BLoC, Riverpod, and Provider.",
            },
          ],
        },
        {
          title: "Software Engineer",
          org: "CRAFT-TEC Inc. · Cebu City, Philippines",
          date: "Mar 2021 - Aug 2022",
          intro:
            "Led the full stack as technical lead on a four-person team of two Flutter and two backend developers, and owned most of what shipped: the majority of the Flutter codebase, the PHP and Laravel services behind the apps, and the CI/CD, release, and deployment work for both.",
          bullets: [
            {
              label: "Flutter Architecture & Ownership",
              text: "Architected the Flutter apps and wrote the majority of the mobile codebase, setting the structure and conventions the team built on across several concurrent projects.",
            },
            {
              label: "Technical Leadership",
              text: "Mentored the other Flutter developer and ran code review and architectural direction across the mobile and backend codebases.",
            },
            {
              label: "CI/CD, Releases & Deployments",
              text: "Built and maintained the CI/CD pipelines for both the Flutter apps and the Laravel backend on Bitbucket Pipelines, and managed releases and deployments across the stack.",
            },
            {
              label: "Backend and API Work",
              text: "Designed and integrated Laravel APIs between the mobile clients and backend services, cutting application load times by 20%.",
            },
          ],
        },
        {
          title: "Software Engineer",
          org: "SystemsCore Inc. & Freelance · Cebu City, Philippines",
          date: "Mar 2019 - Mar 2021",
          intro:
            "Built enterprise systems in C# and .NET Core alongside full-stack web delivery, at SystemsCore and for freelance clients, and introduced CI/CD, version control, and automated testing to the SystemsCore team.",
          bullets: [
            {
              label: ".NET & C# Development",
              text: "Built enterprise systems in C# and .NET Core with Entity Framework and the repository pattern.",
            },
            {
              label: "Web Systems Development",
              text: "Delivered full-stack web systems in JavaScript, Vue.js, and Razor Pages, with Firebase Firestore, Authentication, and Cloud Functions behind the cloud features.",
            },
          ],
        },
      ],
    },
    {
      label: "Skills",
      skills: [
        {
          label: "Mobile",
          items: [
            "Swift",
            "SwiftUI",
            "UIKit",
            "Flutter",
            "Dart",
            "Kotlin",
            "Jetpack Compose",
          ],
        },
        {
          label: "Web",
          items: [
            "JavaScript",
            "TypeScript",
            "React",
            "TanStack",
            "Vue.js",
            "jQuery",
            "HTML",
            "CSS",
          ],
        },
        {
          label: "Backend",
          items: [
            "C#",
            ".NET",
            "Entity Framework",
            "PHP",
            "Laravel",
            "REST APIs",
          ],
        },
        {
          label: "Databases",
          items: ["PostgreSQL", "MySQL", "MSSQL"],
        },
        {
          label: "Cloud & Infrastructure",
          items: [
            "Cloudflare (Workers, R2, Hyperdrive)",
            "Firebase (Auth, Firestore, Cloud Functions)",
            "Docker",
            "OrbStack",
          ],
        },
        {
          label: "CI/CD & Tooling",
          items: [
            "GitHub Actions",
            "Bitbucket Pipelines",
            "Azure DevOps",
            "Fastlane",
            "Git",
            "Xcode",
            "Android Studio",
          ],
        },
        {
          label: "Architecture & Practices",
          items: [
            "Clean Architecture",
            "Layered Architecture",
            "Feature-Driven Architecture",
            "Domain-Driven Design",
            "SOLID Principles",
            "Testing (Unit, Golden, E2E)",
          ],
        },
      ],
    },
    {
      label: "Education",
      dashes: false,
      entries: [
        {
          title: "Bachelor of Science in Information Technology",
          org: "Cristal e-College · Tagbilaran City, Bohol",
          date: "Graduated 2019",
        },
      ],
    },
    {
      label: "Software projects",
      intro:
        "Much of my client and employer work is covered under NDA. The personal projects below are things I build for fun because I enjoy making software, and they offer a public look at the technical skills and engineering practices I bring to my professional work.",
      entries: [
        {
          title:
            "<a href='https://github.com/photosunthesis/bebi-app-flutter' target='_blank' rel='noopener'>Bebi App (for Couples)</a>",
          intro:
            "A couples app for staying connected through shared calendars, daily photo stories, AI-powered cycle tracking insights, and real-time location sharing. Flutter and Dart with BLoC, go_router, and get_it/injectable, on Firebase (Firestore, Auth, Cloud Functions, Analytics, Crashlytics), with media on Cloudflare R2 and Gemini behind the insights. Releases are automated on tag through GitHub Actions.",
        },
        {
          title:
            "<a href='https://rate-stuff.online/' target='_blank' rel='noopener'>rate-stuff.online</a>",
          intro:
            "A social platform for rating and reviewing anything you can think of, with real-time updates, image uploads, and a personalized explore feed. It runs on TypeScript, React 19, TanStack Start/Router/Query, and Tailwind CSS on Cloudflare Workers, over PostgreSQL (CockroachDB through Cloudflare Hyperdrive) with Drizzle ORM and PartyKit WebSockets, plus auth, an image CDN, and transactional email.",
        },
        {
          title:
            "<a href='https://sun-envidiado.com/' target='_blank' rel='noopener'>sun-envidiado.com</a>",
          intro:
            "My personal website and blog, designed after vim and terminal UIs, on Astro and Tailwind CSS running on Cloudflare Workers. Static pages plus a few Worker routes, including a double opt-in newsletter that runs on Resend with no database behind it, MDX blog posts, an RSS feed, and structured data for SEO.",
        },
        {
          title:
            "<a href='https://github.com/photosunthesis/zomboid-b42-server' target='_blank' rel='noopener'>zomboid-b42-server</a>",
          intro:
            "A Docker Compose setup for self-hosting a Project Zomboid server so friends can join without port forwarding, using a playit.gg tunnel, with automated world backups on a schedule.",
        },
      ],
    },
  ],
};

const summaryLabel = "Summary";

const isProd = import.meta.env.PROD;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{resume.name} - Resume</title>
    <!-- Keep personal contact details out of search results and aggregators. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {
      isProd && (
        <script
          is:inline
          defer
          src="https://umami.sun-envidiado.com/script.js"
          data-website-id="bbd2687f-9a6a-4aa4-8813-f5f431278ef6"
        />
      )
    }
  </head>
  <body>
    <!-- Table headers and footers repeat print margins while @page stays at zero. -->
    <table class="sheet" role="presentation">
      <thead>
        <tr><td class="margin"></td></tr>
      </thead>
      <tbody>
        <tr>
          <td class="doc">
            <header>
              <div class="identity">
                <h1 class="name" set:html={nb(resume.name)} />
                <p class="role" set:html={nb(resume.role)} />
              </div>
              <div class="contact">
                {resume.contact.map((line) => <p set:html={nb(line)} />)}
                <div class="profile-links">
                  <a
                    href="https://sun-envidiado.com/"
                    target="_blank"
                    rel="noopener"
                    aria-label="Website: sun-envidiado.com"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="9"></circle>
                      <ellipse cx="12" cy="12" rx="4" ry="9"></ellipse>
                      <path d="M3 12h18"></path>
                    </svg>
                    <span>sun-envidiado.com</span>
                  </a>
                  <span class="contact-separator" aria-hidden="true"
                    >{" · "}</span
                  >
                  <a
                    href="https://github.com/photosunthesis"
                    target="_blank"
                    rel="noopener"
                    aria-label="GitHub: photosunthesis"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        d="M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.104.768-.244.768-.543 0-.267-.01-.975-.015-1.914-3.13.68-3.79-1.508-3.79-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.023-.7.077-.686.077-.686 1.13.08 1.725 1.16 1.725 1.16 1.005 1.722 2.637 1.225 3.28.937.103-.728.394-1.225.716-1.507-2.498-.284-5.124-1.25-5.124-5.565 0-1.23.44-2.235 1.16-3.023-.116-.285-.503-1.43.11-2.98 0 0 .945-.303 3.094 1.155A10.78 10.78 0 0 1 12 6.175c.956.005 1.918.13 2.817.378 2.148-1.458 3.092-1.155 3.092-1.155.614 1.55.227 2.695.112 2.98.721.788 1.158 1.793 1.158 3.023 0 4.325-2.63 5.278-5.136 5.557.404.35.765 1.04.765 2.096 0 1.514-.014 2.735-.014 3.106 0 .302.203.652.774.542A11.251 11.251 0 0 0 12 .75Z"
                      ></path>
                    </svg>
                    <span>photosunthesis</span>
                  </a>
                  <span class="contact-separator" aria-hidden="true"
                    >{" · "}</span
                  >
                  <a
                    href="https://www.linkedin.com/in/sunenvidiado/"
                    target="_blank"
                    rel="noopener"
                    aria-label="LinkedIn: sunenvidiado"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.119 20.452H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"
                      ></path>
                    </svg>
                    <span>sunenvidiado</span>
                  </a>
                </div>
              </div>
              <a
                class="download"
                href="/resume.pdf"
                download={`${resume.name} - Resume.pdf`}
              >
                Download PDF
                <svg
                  class="download-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 3v12"></path>
                  <path d="m7 11 5 5 5-5"></path>
                  <path d="M4 20h16"></path>
                </svg>
              </a>
            </header>

            {
              resume.summary && (
                <section class="section">
                  <h2 class="label">{summaryLabel}</h2>
                  <div class="section-body">
                    <p class="p lead" set:html={nb(resume.summary)} />
                  </div>
                </section>
              )
            }

            {
              resume.sections.map((section) => (
                <section
                  class:list={[
                    "section",
                    { "no-dashes": section.dashes === false },
                  ]}
                >
                  <h2 class="label">{section.label}</h2>
                  <div class="section-body">
                    {section.intro && (
                      <p class="p lead" set:html={nb(section.intro)} />
                    )}
                    {section.entries?.map((entry) => (
                      <article class="entry">
                        <h3 class="title" set:html={nb(entry.title)} />
                        {entry.org && (
                          <p class="org" set:html={nb(entry.org)} />
                        )}
                        {entry.date && (
                          <p class="date" set:html={nb(entry.date)} />
                        )}
                        {entry.intro && (
                          <p class="p" set:html={nb(entry.intro)} />
                        )}
                        {entry.bullets && (
                          <ul class="bullets">
                            {entry.bullets.map((bullet) => (
                              <li
                                set:html={
                                  bullet.label
                                    ? `<b>${nb(bullet.label)}:</b> ${nb(bullet.text)}`
                                    : nb(bullet.text)
                                }
                              />
                            ))}
                          </ul>
                        )}
                      </article>
                    ))}
                    {section.skills?.map((group) => (
                      <p
                        class="p lead skills"
                        set:html={`<b>${nb(group.label)}:</b> ${nb(group.items.join(", "))}`}
                      />
                    ))}
                  </div>
                </section>
              ))
            }
          </td>
        </tr>
      </tbody>
      <tfoot>
        <tr><td class="margin"></td></tr>
      </tfoot>
    </table>

    <script>
      import { yearsOfExperience } from "../../utils/experience";

      const yoe = document.querySelector("[data-yoe]");
      if (yoe) yoe.textContent = String(yearsOfExperience());
    </script>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }

  :root {
    --color-ink: #1f1f1f;
    --color-muted: #737373;
    --sheet-width: 595.28pt;
    --margin-y: 39pt;
    --margin-x: 40pt;
    --indent: 12pt;
  }

  body {
    margin: 0;
    background: #fff;
    color: var(--color-ink);
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: 10pt;
    letter-spacing: normal;
    orphans: 2;
    widows: 2;
  }

  a {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 4px;
  }

  a:hover {
    text-decoration: underline;
  }

  b,
  strong {
    font-weight: 600;
  }

  .nb {
    white-space: nowrap;
  }

  .sheet {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .sheet td {
    padding: 0;
    vertical-align: top;
  }
  .sheet .margin {
    height: var(--margin-y);
  }
  .sheet > tbody > tr > .doc {
    padding: 0 var(--margin-x);
  }

  header {
    break-inside: avoid;
  }

  .name {
    margin: 0;
    font-size: 16pt;
    font-weight: 700;
    line-height: 1.21;
  }
  .role {
    margin: 1pt 0 0;
    font-size: 12pt;
    font-weight: 600;
    line-height: 1.235;
  }
  .contact {
    margin-top: 4pt;
    font-size: 8pt;
    line-height: 1.425;
  }
  .contact p {
    margin: 0;
  }
  .contact-separator {
    margin-inline: 2pt;
    white-space: pre;
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 2pt;
  }
  .profile-links a {
    display: inline-flex;
    align-items: center;
    gap: 3pt;
    white-space: nowrap;
  }
  .profile-links svg {
    width: 8pt;
    height: 8pt;
    flex-shrink: 0;
  }

  .section {
    margin-top: 22pt;
  }
  .section-body {
    padding-left: var(--indent);
  }
  .section-body > .entry > .title {
    position: relative;
  }
  .section-body > .entry > .title::before {
    content: "";
    position: absolute;
    top: 0.5lh;
    left: -7pt;
    width: 3pt;
    height: 3pt;
    border-radius: 50%;
    background: currentColor;
    transform: translateY(-50%);
  }
  .no-dashes .title::before {
    display: none;
  }
  .label {
    margin: 0 0 6pt;
    font-size: 9pt;
    font-weight: 700;
    line-height: 1.21;
    letter-spacing: 0.8pt;
    text-transform: uppercase;
    break-after: avoid;
  }

  .section-body > * + .entry {
    margin-top: 9pt;
  }
  .title {
    margin: 0;
    font-size: 12pt;
    font-weight: 600;
    line-height: 1.235;
    break-after: avoid;
  }
  .org {
    margin: 2pt 0 0;
    font-size: 10pt;
    line-height: 1.235;
    break-after: avoid;
  }
  .date {
    margin: 4pt 0 0;
    color: var(--color-muted);
    font-size: 8pt;
    line-height: 1.21;
    break-after: avoid;
  }

  .p {
    margin: 4pt 0 0;
    line-height: 1.349;
  }
  .lead {
    margin-top: 2pt;
  }
  .skills {
    break-inside: avoid;
  }
  .skills + .skills {
    margin-top: 3pt;
  }
  .entry:not(:has(.date)) {
    break-inside: avoid;
  }
  .section-body > .lead:has(+ .entry) {
    break-inside: avoid;
  }

  .bullets {
    margin: 3.75pt 0 0;
    padding: 0;
    list-style: none;
  }
  .bullets li {
    padding-left: 23.1pt;
    text-indent: -8.9pt;
    line-height: 1.349;
  }
  .bullets li::before {
    content: "\2022\00a0";
  }

  @media screen {
    body {
      padding: 24px 16px;
    }
    header {
      position: relative;
    }
    .download {
      position: absolute;
      top: -22pt;
      right: 0;
      display: inline-flex;
      align-items: center;
      gap: 4pt;
      color: var(--color-muted);
      font-size: 9pt;
      font-weight: 700;
      line-height: 1.21;
      letter-spacing: 0.8pt;
      text-transform: uppercase;
      text-decoration: none;
      transition: color 150ms ease-out;
    }
    .download:hover {
      color: var(--color-ink);
    }
    .download:focus-visible {
      outline: 2px solid var(--color-ink);
      outline-offset: 3px;
    }
    .download-icon {
      width: 9pt;
      height: 9pt;
    }
    .sheet {
      max-width: var(--sheet-width);
      margin: 0 auto;
    }
  }

  @media screen and (max-width: 640px) {
    :root {
      --margin-x: 12pt;
    }
    body {
      padding-inline: 0;
    }
    header {
      padding-top: 24pt;
    }
    .download {
      top: calc((24pt - var(--margin-y) - 24px) / 2);
      transform: translateY(-50%);
    }
  }

  @media print {
    .download {
      display: none;
    }
    a {
      text-decoration: none;
    }
