// `summary` is a top level field rather than a section, but ATS parsers look
// for a SUMMARY heading, so it is rendered as the first section under this.
const summaryLabel = "Summary";

const isProd = import.meta.env.PROD;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Chrome and Safari use the document title as the default filename when
         saving to PDF. Plain hyphen on purpose: some systems choke on dashes. -->
    <title>{resume.name} - Resume</title>
    <!-- noindex: this page prints a phone number and email address in plain
         text, and a resume is something to hand out deliberately rather than
         have aggregators scrape. To index it, delete this tag and remove
         "/work/resume" from the sitemap filter in astro.config.mjs. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <!-- Same analytics snippet BaseLayout adds to every page. -->
    {
      isProd && (
        <script
          is:inline
          defer
          src="https://umami.sun-envidiado.com/script.js"
          data-website-id="bbd2687f-9a6a-4aa4-8813-f5f431278ef6"
        />
      )
    }
  </head>
  <body>
    <!-- Screen only, hidden in print. Two things this page cannot control:
         the user still has to pick "Save as PDF" as the destination, and
         untick "Headers and footers" or the file gets the URL and date printed
         on it. When public/resume.pdf exists, replace the button with
         <a href="/resume.pdf" download> for a real one click download. -->
    <div class="toolbar">
      <button type="button" class="print" data-print>
        <svg
          class="print-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3v12"></path>
          <path d="m7 11 5 5 5-5"></path>
          <path d="M4 20h16"></path>
        </svg>
        Download as PDF
      </button>
    </div>

    <!-- Layout table on purpose: thead and tfoot repeat on every printed sheet,
         which is the only way to get the same top and bottom whitespace on
         every page while keeping @page margin at 0 (so a background could
         reach the paper edge). Horizontal padding lives on the body cell
         because it repeats across pages on its own. -->
    <table class="sheet" role="presentation">
      <thead>
        <tr><td class="margin"></td></tr>
      </thead>
      <tbody>
        <tr>
          <td class="doc">
            <header>
              <h1 class="name" set:html={nb(resume.name)} />
              <p class="role" set:html={nb(resume.role)} />
              <div class="contact">
                {resume.contact.map((line) => <p set:html={nb(line)} />)}
              </div>
            </header>

            {
              resume.summary && (
                <section class="section">
                  <h2 class="label">{summaryLabel}</h2>
                  <div class="section-body">
                    <p class="p lead" set:html={nb(resume.summary)} />
                  </div>
                </section>
              )
            }

            {
              resume.sections.map((section) => (
                <section
                  class:list={[
                    "section",
                    { "no-dashes": section.dashes === false },
                  ]}
                >
                  <h2 class="label">{section.label}</h2>
                  <div class="section-body">
                    {section.intro && (
                      <p class="p lead" set:html={nb(section.intro)} />
                    )}
                    {section.entries?.map((entry) => (
                      <article class="entry">
                        <h3 class="title" set:html={nb(entry.title)} />
                        {entry.org && (
                          <p class="org" set:html={nb(entry.org)} />
                        )}
                        {entry.date && (
                          <p class="date" set:html={nb(entry.date)} />
                        )}
                        {entry.intro && (
                          <p class="p" set:html={nb(entry.intro)} />
                        )}
                        {entry.bullets && (
                          <ul class="bullets">
                            {entry.bullets.map((bullet) => (
                              <li
                                set:html={
                                  bullet.label
                                    ? `<b>${nb(bullet.label)}:</b> ${nb(bullet.text)}`
                                    : nb(bullet.text)
                                }
                              />
                            ))}
                          </ul>
                        )}
                      </article>
                    ))}
                    {section.skills?.map((group) => (
                      <p
                        class="p lead skills"
                        set:html={`<b>${nb(group.label)}:</b> ${nb(group.items.join(", "))}`}
                      />
                    ))}
                  </div>
                </section>
              ))
            }
          </td>
        </tr>
      </tbody>
      <tfoot>
        <tr><td class="margin"></td></tr>
      </tfoot>
    </table>

    <script>
      import { yearsOfExperience } from "../../utils/experience";

      document
        .querySelector("[data-print]")
        ?.addEventListener("click", () => window.print());

      // Baked at build; refreshed on load so it rolls over without a redeploy.
      const yoe = document.querySelector("[data-yoe]");
      if (yoe) yoe.textContent = String(yearsOfExperience());
    </script>
  </body>
</html>

<style is:global>
  /* Global on purpose: this page owns its whole document, and scoped styles
     cannot reach the <a>/<b> markup or the .nb spans injected via set:html. */
  @page {
    size: A4;
    margin: 0;
  }

  :root {
    --color-ink: #1f1f1f;
    --color-muted: #737373;
    --sheet-width: 595.28pt;
    --margin-y: 39pt;
    --margin-x: 40pt;
    --indent: 12pt;
  }

  body {
    margin: 0;
    background: #fff;
    color: var(--color-ink);
    font-family:
      "Inter",
      system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      Helvetica,
      Arial,
      sans-serif;
    font-size: 10pt;
    letter-spacing: -0.4pt;
    /* Two lines minimum either side of a page break, so a paragraph never
       leaves a single stray word at the top or bottom of a sheet. */
    orphans: 2;
    widows: 2;
  }

  a {
    color: inherit;
    text-decoration: underline;
  }

  b,
  strong {
    font-weight: 600;
  }

  .nb {
    white-space: nowrap;
  }

  /* Repeating page margins: see the comment on the table in the markup. */
  .sheet {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .sheet td {
    padding: 0;
    vertical-align: top;
  }
  .sheet .margin {
    height: var(--margin-y);
  }
  .sheet > tbody > tr > .doc {
    padding: 0 var(--margin-x);
  }

  .name {
    margin: 0;
    font-size: 16pt;
    font-weight: 700;
    line-height: 1.21;
  }
  .role {
    margin: 1pt 0 0;
    font-size: 12pt;
    font-weight: 600;
    line-height: 1.235;
  }
  .contact {
    margin-top: 4pt;
    font-size: 8pt;
    line-height: 1.425;
  }
  .contact p {
    margin: 0;
  }

  .section {
    margin-top: 22pt;
  }
  /* Everything under a section heading sits a little to the right of it. */
  .section-body {
    padding-left: var(--indent);
  }
  /* Dash marker in the indent gutter beside each entry title. Drawn as a
     border, not a dash character, so nothing lands in the PDF's text layer
     for an ATS to read. */
  .section-body > .entry > .title {
    position: relative;
  }
  .section-body > .entry > .title::before {
    content: "";
    position: absolute;
    /* Middle of the first line only, so a wrapped title keeps it on line one. */
    top: 0.5lh;
    left: calc(-1 * var(--indent));
    width: calc(var(--indent) - 3pt);
    border-top: 0.08em solid currentColor;
    transform: translateY(-50%);
  }
  .no-dashes .title::before {
    display: none;
  }
  /* Smaller than the entry titles on purpose: the caps and tracking already
     mark a heading, so the size can step back and let the entries lead. */
  .label {
    margin: 0 0 6pt;
    font-size: 9pt;
    font-weight: 700;
    line-height: 1.21;
    letter-spacing: 0.8pt;
    text-transform: uppercase;
    break-after: avoid;
  }

  /* Any entry that follows something (a section intro or another entry). */
  .section-body > * + .entry {
    margin-top: 9pt;
  }
  .title {
    margin: 0;
    font-size: 12pt;
    font-weight: 600;
    line-height: 1.235;
    break-after: avoid;
  }
  .org {
    margin: 2pt 0 0;
    font-size: 10pt;
    line-height: 1.235;
    break-after: avoid;
  }
  .date {
    margin: 4pt 0 0;
    color: var(--color-muted);
    font-size: 8pt;
    line-height: 1.21;
    break-after: avoid;
  }

  .p {
    margin: 4pt 0 0;
    line-height: 1.349;
  }
  .lead {
    margin-top: 2pt;
  }
  .skills {
    break-inside: avoid;
  }
  .skills + .skills {
    margin-top: 3pt;
  }
  /* A section intro must not be the last thing on a page, and a short entry
     must not be split across one. */
  /* Project entries are the short, dateless ones; keeping them whole stops a
     four-line blurb splitting across a sheet. */
  .entry:not(:has(.date)) {
    break-inside: avoid;
  }
  /* Only a lead that introduces entries, so the rule cannot chain "keep with
     the next thing" from one section into the one after it. */
  .section-body > .lead:has(+ .entry) {
    break-inside: avoid;
  }

  .bullets {
    margin: 3.75pt 0 0;
    padding: 0;
    list-style: none;
  }
  .bullets li {
    padding-left: 23.1pt;
    text-indent: -8.9pt;
    line-height: 1.349;
  }
  .bullets li::before {
    content: "\2022\00a0";
  }

  /* Screen affordances: the print button, and the document kept at A4 width. */
  @media screen {
    body {
      /* Room at the bottom so the floating button never sits over the last lines. */
      padding: 24px 16px 96px;
    }
    /* Pinned to the bottom of the window but only as wide as the document
       column (same width and centering as .sheet), so the button hugs the
       column's corner instead of drifting to the screen edge on wide monitors. */
    .toolbar {
      position: fixed;
      right: 0;
      bottom: 24px;
      left: 0;
      z-index: 1;
      display: flex;
      justify-content: flex-end;
      width: min(var(--sheet-width), 100% - 32px);
      margin: 0 auto;
      /* Let clicks through the empty part of the strip to the text below. */
      pointer-events: none;
    }
    .print {
      pointer-events: auto;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 13px 22px;
      border: 0;
      /* corner-shape is progressive: browsers without it keep the radius. */
      border-radius: 16px;
      corner-shape: squircle;
      background: var(--color-ink);
      color: #fff;
      font: inherit;
      font-size: 15px;
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: 0;
      cursor: pointer;
      box-shadow:
        0 1px 2px rgb(0 0 0 / 0.08),
        0 6px 16px rgb(0 0 0 / 0.1);
      transition:
        background-color 150ms ease-out,
        box-shadow 150ms ease-out,
        transform 150ms ease-out;
    }
    .print-icon {
      width: 17px;
      height: 17px;
    }
    .print:hover {
      background: #333;
      box-shadow:
        0 2px 4px rgb(0 0 0 / 0.1),
        0 10px 24px rgb(0 0 0 / 0.14);
      transform: translateY(-1px);
    }
    .print:active {
      background: #111;
      box-shadow: 0 1px 2px rgb(0 0 0 / 0.1);
      transform: translateY(0);
    }
    .print:focus-visible {
      outline: 2px solid var(--color-ink);
      outline-offset: 2px;
    }
    .sheet {
      max-width: var(--sheet-width);
      margin: 0 auto;
    }
  }

  /* Phones: the print margins waste too much of a narrow screen. */
  @media screen and (max-width: 640px) {
    :root {
