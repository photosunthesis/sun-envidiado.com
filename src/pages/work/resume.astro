      ],
    },
    {
      label: "Education",
      dashes: false,
      entries: [
        {
          title: "Bachelor of Science in Information Technology",
          org: "Cristal e-College · Tagbilaran City, Bohol",
          date: "Graduated 2019",
        },
      ],
    },
    {
      label: "Software projects",
      intro:
        "Most of my professional software work is covered under NDA and isn't publicly shareable, but here are a few personal projects that showcase my skills outside of client and employer work.",
      entries: [
        {
          title:
            "<a href='https://github.com/photosunthesis/bebi-app-flutter' target='_blank' rel='noopener'>Bebi App (for Couples)</a>",
