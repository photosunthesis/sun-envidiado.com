// `summary` is a top level field rather than a section, but ATS parsers look
// for a SUMMARY heading, so it is rendered as the first section under this.
const summaryLabel = "Summary";

const isProd = import.meta.env.PROD;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Chrome and Safari use the document title as the default filename when
         saving to PDF. Plain hyphen on purpose: some systems choke on dashes. -->
    <title>{resume.name} - Resume</title>
    <!-- noindex: this page prints a phone number and email address in plain
         text, and a resume is something to hand out deliberately rather than
         have aggregators scrape. To index it, delete this tag and remove
         "/work/resume" from the sitemap filter in astro.config.mjs. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <!-- Same analytics snippet BaseLayout adds to every page. -->
    {
      isProd && (
        <script
          is:inline
          defer
          src="https://umami.sun-envidiado.com/script.js"
          data-website-id="bbd2687f-9a6a-4aa4-8813-f5f431278ef6"
        />
      )
    }
  </head>
  <body>
    <!-- Screen only, hidden in print. Two things this page cannot control:
         the user still has to pick "Save as PDF" as the destination, and
         untick "Headers and footers" or the file gets the URL and date printed
         on it. When public/resume.pdf exists, replace the button with
         <a href="/resume.pdf" download> for a real one click download. -->
    <div class="toolbar">
      <button type="button" class="print" data-print>Download PDF</button>
    </div>

    <!-- Layout table on purpose: thead and tfoot repeat on every printed sheet,
         which is the only way to get the same top and bottom whitespace on
         every page while keeping @page margin at 0 (so a background could
         reach the paper edge). Horizontal padding lives on the body cell
         because it repeats across pages on its own. -->
    <table class="sheet" role="presentation">
      <thead>
        <tr><td class="margin"></td></tr>
      </thead>
      <tbody>
        <tr>
          <td class="doc">
            <header>
              <h1 class="name" set:html={nb(resume.name)} />
              <p class="role" set:html={nb(resume.role)} />
              <div class="contact">
                {resume.contact.map((line) => <p set:html={nb(line)} />)}
              </div>
            </header>

            {
              resume.summary && (
                <section class="section">
                  <h2 class="label">{summaryLabel}</h2>
                  <div class="section-body">
                    <p class="p lead" set:html={nb(resume.summary)} />
                  </div>
                </section>
              )
            }

            {
              resume.sections.map((section) => (
                <section class="section">
                  <h2 class="label">{section.label}</h2>
                  <div class="section-body">
                    {section.intro && (
                      <p class="p lead" set:html={nb(section.intro)} />
                    )}
                    {section.entries?.map((entry) => (
                      <article class="entry">
                        <h3 class="title" set:html={nb(entry.title)} />
                        {entry.date && (
                          <p class="date" set:html={nb(entry.date)} />
                        )}
                        {entry.intro && (
                          <p class="p" set:html={nb(entry.intro)} />
                        )}
                        {entry.bullets && (
                          <ul class="bullets">
                            {entry.bullets.map((bullet) => (
                              <li
                                set:html={
                                  bullet.label
                                    ? `<b>${nb(bullet.label)}:</b> ${nb(bullet.text)}`
                                    : nb(bullet.text)
                                }
                              />
                            ))}
                          </ul>
                        )}
                      </article>
                    ))}
                    {section.skills && (
                      <p
                        class="p lead skills"
                        set:html={nb(section.skills.join(", "))}
                      />
                    )}
                  </div>
                </section>
              ))
            }
          </td>
        </tr>
      </tbody>
      <tfoot>
        <tr><td class="margin"></td></tr>
      </tfoot>
    </table>

    <script>
      document
        .querySelector("[data-print]")
        ?.addEventListener("click", () => window.print());
    </script>
  </body>
</html>

<style is:global>
  /* Global on purpose: this page owns its whole document, and scoped styles
     cannot reach the <a>/<b> markup or the .nb spans injected via set:html. */
  @page {
    size: A4;
    margin: 0;
  }

  :root {
    --color-ink: #1f1f1f;
    --color-muted: #737373;
    --sheet-width: 595.28pt;
    --margin-y: 39pt;
    --margin-x: 40pt;
    --indent: 12pt;
  }

  body {
    margin: 0;
    background: #fff;
    color: var(--color-ink);
    font-family:
      "Inter Variable",
      system-ui,
      -apple-system,
      "Segoe UI",
      Roboto,
      Helvetica,
      Arial,
      sans-serif;
    font-size: 10pt;
    letter-spacing: -0.4pt;
    orphans: 1;
    widows: 1;
  }

  a {
    color: inherit;
    text-decoration: underline;
  }

  b,
  strong {
    font-weight: 600;
  }

  .nb {
    white-space: nowrap;
  }

  /* Repeating page margins: see the comment on the table in the markup. */
  .sheet {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .sheet td {
    padding: 0;
    vertical-align: top;
  }
  .sheet .margin {
    height: var(--margin-y);
  }
  .sheet > tbody > tr > .doc {
    padding: 0 var(--margin-x);
  }

  .name {
    margin: 0;
    font-size: 16pt;
    font-weight: 700;
    line-height: 1.21;
  }
  .role {
    margin: 1pt 0 0;
    font-size: 12pt;
    font-weight: 600;
    line-height: 1.235;
  }
  .contact {
    margin-top: 4pt;
    font-size: 8pt;
    line-height: 1.425;
  }
  .contact p {
    margin: 0;
  }

  .section {
    margin-top: 18pt;
  }
  /* Everything under a section heading sits a little to the right of it. */
  .section-body {
    padding-left: var(--indent);
  }
  .label {
    margin: 0 0 2pt;
    font-size: 10.5pt;
    font-weight: 700;
    line-height: 1.21;
    letter-spacing: 0.6pt;
    text-transform: uppercase;
    break-after: avoid;
  }

  /* Any entry that follows something (a section intro or another entry). */
  .section-body > * + .entry {
    margin-top: 9pt;
  }
  .title {
    margin: 0;
    font-size: 12pt;
    font-weight: 600;
    line-height: 1.235;
    break-after: avoid;
  }
  .date {
    margin: 5.4pt 0 0;
    color: var(--color-muted);
    font-size: 8pt;
    line-height: 1.21;
    break-after: avoid;
  }

  .p {
    margin: 6.6pt 0 0;
    font-size: 10pt;
    line-height: 1.349;
  }
  .lead {
    margin-top: 2pt;
  }
  .skills {
    break-inside: avoid;
  }

  .bullets {
    margin: 5.1pt 0 0;
    padding: 0;
    list-style: none;
  }
  .bullets li {
    position: relative;
    padding-left: 23.1pt;
    font-size: 10pt;
    line-height: 1.349;
  }
  .bullets li::before {
    content: "\2022";
    position: absolute;
    left: 14.2pt;
  }

  /* Screen affordances: the print button, and the document kept at A4 width. */
  @media screen {
    body {
      padding: 24px 16px 48px;
    }
    .toolbar {
      position: fixed;
      top: 16px;
      right: 16px;
      z-index: 1;
    }
    .print {
      padding: 9px 16px;
      border: 0;
      /* corner-shape is progressive: browsers without it keep the radius. */
      border-radius: 14px;
      corner-shape: squircle;
      background: var(--color-ink);
      color: #fff;
      font: inherit;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0;
      cursor: pointer;
      transition: opacity 150ms ease-out;
    }
    .print:hover {
      opacity: 0.85;
    }
    .print:active {
      opacity: 0.7;
    }
    .print:focus-visible {
      outline: 2px solid var(--color-ink);
      outline-offset: 2px;
    }
    .sheet {
      max-width: var(--sheet-width);
      margin: 0 auto;
    }
  }

  /* Phones: the print margins waste too much of a narrow screen. */
  @media screen and (max-width: 640px) {
    :root {
      --margin-x: 12pt;
    }
    body {
      padding: 24px 0 48px;
    }
  }

  @media print {
    .toolbar {
      display: none;
    }
    /* Underlines are a screen affordance; the PDF keeps links unmarked. */
    a {
      text-decoration: none;
    }
  }
</style>
