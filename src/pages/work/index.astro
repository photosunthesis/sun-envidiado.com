---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CAREER_START, yearsOfExperience } from "../../utils/experience";
import { PERSON_ID, SITE, absoluteUrl } from "../../utils/seo";
import { thumbHashFromPath } from "../../utils/thumbhash";
import bebiAppImage from "./_assets/bebi-app.png";
import rateStuffImage from "./_assets/rate-stuff-online.png";
import twentyFourToTwelveImage from "./_assets/24-to-12.png";
import zomboidImage from "./_assets/zomboid.png";

const years = yearsOfExperience();

const description = `Software engineer with ${years}+ years of experience — currently focused on Swift and native iOS development.`;

const [rateStuffHash, bebiAppHash, twentyFourHash, zomboidHash] =
  await Promise.all(
    [rateStuffImage, bebiAppImage, twentyFourToTwelveImage, zomboidImage].map(
      (img) =>
        thumbHashFromPath((img as ImageMetadata & { fsPath: string }).fsPath),
    ),
  );

const projects = [
  {
    title: "Bebi App",
    url: "https://github.com/photosunthesis/bebi-app-flutter",
    image: bebiAppImage,
    placeholder: bebiAppHash,
    alt: "Screenshot of Bebi App",
    description:
      "A Flutter app for couples — shared photo albums, a shared calendar, and cycle tracking, with a Firebase backend. A personal project for my partner and me.",
  },
  {
    title: "rate-stuff.online",
    url: "https://github.com/photosunthesis/rate-stuff.online",
    image: rateStuffImage,
    placeholder: rateStuffHash,
    alt: "Screenshot of rate-stuff.online",
    description:
      "A website for rating and reviewing anything you can think of. Built with React, TanStack Start, and TypeScript on Cloudflare Workers — my deep dive into the modern serverless stack.",
  },
  {
    title: "zomboid-b42-server",
    url: "https://github.com/photosunthesis/zomboid-b42-server",
    image: zomboidImage,
    placeholder: zomboidHash,
    alt: "Screenshot of the zomboid-b42-server repository",
    description:
      "A Docker Compose setup for self-hosting a Project Zomboid server so my friends can join without me touching my router. Containers, a playit.gg tunnel, and automated world backups.",
  },
  {
    title: "24-to-12",
    url: "https://github.com/photosunthesis/24-to-12",
    image: twentyFourToTwelveImage,
    placeholder: twentyFourHash,
    alt: "Screenshot of the 24to12 web app",
    description:
      "A small web app that converts 24-hour time to 12-hour time, because I cannot do the subtraction in my head. Built in vanilla JavaScript over a single morning.",
  },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: absoluteUrl("/work", Astro.site),
  mainEntity: {
    "@id": PERSON_ID,
    "@type": "Person",
    name: SITE.name,
    url: SITE.url,
    jobTitle: "Software Engineer",
    description,
  },
};
---

<BaseLayout
  title="Work — Sun Envidiado"
  description={description}
  variant="doc"
  jsonLd={jsonLd}
>
  <article class="leading-relaxed">
    <h1 class="sr-only">Work</h1>

    <section class="space-y-[1lh]">
      <p>
        I've been building software for over <time
          datetime={CAREER_START}
          id="yoe">{years}</time
        > years, across mobile, web, and backend. These days I build iOS apps with
        Swift and cross-platform apps with Flutter—still my favorite stack.
      </p>
      <p>
        My work has spanned fintech, healthcare, and other industries, from
        building features to shaping app architecture and helping teams test and
        ship. I've worked on the backend services behind those apps too, so I'm
        comfortable taking something from the database through to the interface.
      </p>
      <p>
        You can find the full timeline and details in <a
          class="link"
          href="/work/resume"
          target="_blank"
          rel="noopener noreferrer">my resume</a
        >. Below are a few personal projects I've built for myself and the
        people around me.
      </p>
    </section>

    <section class="mt-12">
      <ul class="space-y-[2lh]">
        {
          projects.map((project) => (
            <li class="grid grid-cols-1 gap-[1lh] md:grid-cols-[180px_1fr] md:gap-[2ch]">
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                data-lqip
                class="block aspect-4/3 w-full overflow-hidden rounded border border-neutral-800"
                style={`background-image: url('${project.placeholder}'); background-size: cover; background-position: center; background-color: var(--color-vim-code);`}
              >
                <Picture
                  src={project.image}
                  formats={["avif", "webp"]}
                  fallbackFormat="jpg"
                  widths={[200, 400, 600]}
                  sizes="(max-width: 768px) 100vw, 200px"
                  loading="lazy"
                  alt={project.alt}
                  class="h-full w-full object-cover opacity-0 transition-opacity duration-500 ease-out motion-reduce:transition-none"
                />
              </a>
              <div>
                <a
                  class="link font-semibold"
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {project.title}
                </a>
                <p class="mt-[0.25lh]">{project.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
    <p class="mt-12">
      Always open to a conversation. You'll find ways to reach me on the <a
        class="link"
        href="/contact">contact page</a
      >.
    </p>
  </article>

  <script>
    import { yearsOfExperience } from "../../utils/experience";

    const el = document.getElementById("yoe");
    if (el) el.textContent = String(yearsOfExperience());
  </script>
</BaseLayout>
