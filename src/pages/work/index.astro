---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CAREER_START, yearsOfExperience } from "../../utils/experience";
import { PERSON_ID, SITE, absoluteUrl } from "../../utils/seo";
const years = yearsOfExperience();

const description = `Senior Web and App Developer at DAI Post with ${years}+ years of experience, building applications for the logistics industry.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: absoluteUrl("/work", Astro.site),
  mainEntity: {
    "@id": PERSON_ID,
    "@type": "Person",
    name: SITE.name,
    url: SITE.url,
    jobTitle: "Senior Web and App Developer",
    worksFor: {
      "@type": "Organization",
      name: "DAI Post",
    },
    description,
  },
};
---

<BaseLayout
  title="Work — Sun Envidiado"
  description={description}
  jsonLd={jsonLd}
>
  <article class="max-w-[70ch] leading-relaxed">
    <h1 class="sr-only">Work</h1>

    <section class="space-y-[1lh]">
      <p>
        I've been building software for over <time
          datetime={CAREER_START}
          id="yoe">{years}</time
        > years, from full-stack web applications to native and cross-platform mobile
        apps and the backend services behind them. I'm currently a Senior Web and
        App Developer at DAI Post, working on systems that support logistics operations.
      </p>
      <p>
        My work has spanned industries including fintech, healthcare, and most
        recently, logistics, from building features to shaping app architecture
        and helping teams test and ship. I work across the frontend and backend,
        building and improving the applications people rely on in their
        day-to-day work.
      </p>
      <p>
        You can find the full timeline and details in <a
          class="link"
          href="/work/resume"
          target="_blank"
          rel="noopener noreferrer">my resume</a
        >.
      </p>
      <p>
        If you'd like to talk about working together or swap ideas, feel free to <a
          class="link"
          href="/contact">get in touch</a
        >.
      </p>
    </section>
  </article>

  <script>
    import { yearsOfExperience } from "../../utils/experience";

    const el = document.getElementById("yoe");
    if (el) el.textContent = String(yearsOfExperience());
  </script>
</BaseLayout>
