---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a href="/" data-back class:list={["action", className]}> [BACK] </a>

<script>
  document.querySelectorAll("a[data-back]").forEach((el) => {
    el.addEventListener("click", (e) => {
      if (window.history.length <= 1 || !document.referrer) return;
      try {
        if (new URL(document.referrer).origin !== window.location.origin)
          return;
      } catch {
        return;
      }
      e.preventDefault();
      window.history.back();
    });
  });
</script>
