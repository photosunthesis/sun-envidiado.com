{
  "name": "personal_website_astro",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "pnpm build && astro preview",
    "build": "astro build && tsx scripts/resume-pdf.ts",
    "build:prod": "tsx scripts/send-newsletter.ts && pnpm build",
    "deploy": "pnpm build && wrangler deploy",
    "resume:pdf": "tsx scripts/resume-pdf.ts",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "newsletter": "tsx scripts/send-newsletter.ts",
    "preview:emails": "tsx scripts/preview-emails.ts --open",
    "optimize:images": "tsx scripts/optimize-images.ts",
    "bearblog": "tsx scripts/bearblog-export.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "astro-seo": "^1.2.0",
    "jose": "^6.2.12",
    "resend": "^6.32.1",
    "tailwindcss": "^4.3.3",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "astro-eslint-parser": "^3.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fast-glob": "^3.3.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "wrangler": "^4.149.0"
  }
}
